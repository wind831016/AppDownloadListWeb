<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="App下載平台，提供各類應用程式" />
    <title>@ViewData["Title"] - AppDownloadListWeb</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <!-- Styles -->
    <link rel="icon" type="image/png" href="~/Image/favicon.png" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap">
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
    <link rel="stylesheet" href="~/Styles/Common/styleCommon.css" />
    <link rel="stylesheet" href="~/Styles/Shared/styleLayout.css" />
    <link rel="stylesheet" href="~/Styles/Common/styleSearch.css" />

    <!-- Javascript -->
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/Common/searchInteraction.js"></script>
</head>
<body>
    <!-- 導航欄 -->
    <nav class="navbar navbar-expand-lg navbar-light navbar-airy sticky-top">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <img src="~/Image/logo.png" alt="MyAppStore Logo" class="img-fluid" width="150" height="auto">
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Home" ? "active" : "")"
                           href="@Url.Action("Index", "Home")" aria-current="@(ViewContext.RouteData.Values["controller"].ToString() == "Home" ? "page" : "false")">
                            HOME
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "App" && ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")"
                           href="@Url.Action("Index", "App")" aria-current="@(ViewContext.RouteData.Values["controller"].ToString() == "App" && ViewContext.RouteData.Values["action"].ToString() == "Index" ? "page" : "false")">
                            SHOP
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Category" ? "active" : "")"
                           href="@Url.Action("Index", "Category")" aria-current="@(ViewContext.RouteData.Values["controller"].ToString() == "Category" ? "page" : "false")">
                            TEMPLATE
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            DROPDOWN
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                            <li><h6 class="dropdown-header">Dropdown header</h6></li>
                            <li><a class="dropdown-item" href="#">Action</a></li>
                            <li><a class="dropdown-item" href="#">Another action</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Contact" ? "active" : "")"
                           href="@Url.Action("Index", "Contact")" aria-current="@(ViewContext.RouteData.Values["controller"].ToString() == "Contact" ? "page" : "false")">
                            CONTACT
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Docs" ? "active" : "")"
                           href="@Url.Action("Index", "Docs")" aria-current="@(ViewContext.RouteData.Values["controller"].ToString() == "Docs" ? "page" : "false")">
                            DOCS
                        </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center navbar-actions">
                    <!-- Search Button-->
                    <div class="nav-item navbar-icon-link" data-bs-toggle="search">
                        <a class="nav-link p-0 mx-2" href="#" aria-label="搜索">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                            </svg>
                        </a>
                    </div>
                    <div class="nav-item navbar-icon-link">
                        <a class="nav-link p-0 mx-2" href="@Url.Action("Index", "Account")" aria-label="個人帳戶">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                                <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0" />
                                <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1" />
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- 更新後的搜尋容器HTML -->
    <div class="search-container" id="searchContainer">
        <form class="search-form" id="searchForm" method="get" action="/search">
            <input type="text" class="search-input" id="searchInput" name="q" placeholder="輸入搜尋關鍵字..." autocomplete="off" required>
            <button type="submit" class="search-submit" aria-label="搜尋">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                </svg>
            </button>
        </form>
        <button class="search-close" id="closeSearchBox" aria-label="關閉搜尋">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
                <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854Z" />
            </svg>
        </button>
    </div>

    <!-- 主內容 -->
    <main class="container py-4" role="main" id="mainContent">
        @RenderBody()
    </main>

    <!-- 頁腳 -->
    <footer class="footer">
        <div class="container">
            <div class="footer-links row">
                <div class="footer-column col-lg-3 col-md-6 col-sm-6">
                    <h4 class="footer-title">關於我們</h4>
                    <ul class="footer-menu list-unstyled">
                        <li><a href="#" class="footer-link">公司簡介</a></li>
                        <li><a href="#" class="footer-link">聯繫我們</a></li>
                        <li><a href="#" class="footer-link">隱私政策</a></li>
                        <li><a href="#" class="footer-link">服務條款</a></li>
                    </ul>
                </div>
                <div class="footer-column col-lg-3 col-md-6 col-sm-6">
                    <h4 class="footer-title">開發者</h4>
                    <ul class="footer-menu list-unstyled">
                        <li><a href="#" class="footer-link">開發者中心</a></li>
                        <li><a href="#" class="footer-link">上傳應用</a></li>
                        <li><a href="#" class="footer-link">開發者政策</a></li>
                        <li><a href="#" class="footer-link">開發者論壇</a></li>
                    </ul>
                </div>
                <div class="footer-column col-lg-3 col-md-6 col-sm-6">
                    <h4 class="footer-title">支援</h4>
                    <ul class="footer-menu list-unstyled">
                        <li><a href="#" class="footer-link">幫助中心</a></li>
                        <li><a href="#" class="footer-link">常見問題</a></li>
                        <li><a href="#" class="footer-link">反饋</a></li>
                        <li><a href="#" class="footer-link">系統需求</a></li>
                    </ul>
                </div>
                <div class="footer-column col-lg-3 col-md-6 col-sm-6">
                    <h4 class="footer-title">關注我們</h4>
                    <ul class="social-links list-unstyled">
                        <li><a href="#" class="footer-link"><i class="fab fa-facebook"></i> Facebook</a></li>
                        <li><a href="#" class="footer-link"><i class="fab fa-twitter"></i> Twitter</a></li>
                        <li><a href="#" class="footer-link"><i class="fab fa-instagram"></i> Instagram</a></li>
                        <li><a href="#" class="footer-link"><i class="fab fa-youtube"></i> YouTube</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; @DateTime.Now.Year &ensp; TouchFish. &ensp; 版權所有。</p>
            </div>
        </div>
    </footer>

    <!-- 返回頂部按鈕 -->
    <button class="back-to-top" id="backToTop" aria-label="返回頂部">
        <i class="fas fa-arrow-up"></i>
    </button>

    <script>
        // 返回頂部按鈕
        document.addEventListener('DOMContentLoaded', function () {
            const backToTopBtn = document.getElementById('backToTop');

            // 捲動監聽
            window.addEventListener('scroll', function () {
                if (window.pageYOffset > 300) {
                    backToTopBtn.classList.add('visible');
                } else {
                    backToTopBtn.classList.remove('visible');
                }
            });

            // 點擊事件
            backToTopBtn.addEventListener('click', function (e) {
                e.preventDefault();
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            });
        });
    </script>

    @RenderSection("scripts", required: false)

</body>
</html>