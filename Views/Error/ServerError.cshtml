@{
    Layout = null;
    ViewData["Title"] = "500";
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AppDownloadListWeb</title>

    <!-- Styles -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto">
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
    <link rel="stylesheet" href="~/Styles/Common/styleCommon.css" />
    <link rel="stylesheet" href="~/Styles/Error/styleServerError.css" />

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <!-- Javascript -->
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
</head>
<body>
    <!-- 主內容 -->
    <main class="container" role="main">
        <div class="hero-block">
            <!-- 左側面板 -->
            <div class="hero-block__left-panel">
                <div id="stars-container"></div>

                <div class="hero-block__left-panel__planet">
                    <img class="img-fluid" src="~/Image/Space/03.svg" alt="planet">
                </div>
                <div class="hero-block__left-panel__starSigns">
                    <img class="img-fluid" src="~/Image/Space/02.svg" alt="starSigns">
                </div>
                <div class="hero-block__left-panel__mars">
                    <img class="img-fluid" src="~/Image/Space/08.svg" alt="Mars">
                </div>
                <div class="hero-block__left-panel__mars-circle"></div>
                <div class="hero-block__left-panel__shootStar">
                    <img class="img-fluid" src="~/Image/Space/01.svg" alt="shootStar">
                </div>
                <div class="hero-block__left-panel__UOF">
                    <img class="img-fluid" src="~/Image/Space/04.svg" alt="UOF">
                </div>
            </div>

            <!-- 右側面板 -->
            <div class="hero-block__right-panel col-md-6 align-self-center">
                <h1>500</h1>
                <h2>Opps! Internal Server Error.</h2>
                <p>
                    Unfortunately we're having trouble loading the page you are looking for.
                </p>
            </div>
        </div>
    </main>
     <script>
         document.addEventListener('DOMContentLoaded', function () {
             generateStars(20);

             // 添加窗口大小變化監聽器
             window.addEventListener('resize', handleResponsiveElements);
         });

         function handleResponsiveElements() {
             const width = window.innerWidth;
             const starsCount = width < 768 ? 10 : 20;

             // 清除並重新生成星星
             document.getElementById('stars-container').innerHTML = '';

             generateStars(starsCount);
         }

         function generateStars(count) {
             const starsContainer = document.getElementById('stars-container');

             for (let i = 0; i < count; i++) {
                 const star = document.createElement('div');
                 star.className = 'hero-block__left-panel__star';

                 const top = Math.random() * 90 + 5;  
                 const left = Math.random() * 90 + 5; 
                 const size = Math.random() * 2 + 2;  
                 const delay = Math.random() * 3;

                 star.style.top = top + '%';
                 star.style.left = left + '%';
                 star.style.width = size + 'px';
                 star.style.height = size + 'px';
                 star.style.animationDelay = delay + 's';

                 starsContainer.appendChild(star);
             }
         }

         function setTimeMarsCircleColors() {
             const hour = new Date().getHours();
             const circleContainer = document.getElementById('hero-block__left-panel__mars-circle');
             let backgroundColor;

             if (hour >= 5 && hour < 12) {
                 backgroundColor = "var(--secondary-color)";
             } else if (hour >= 12 && hour < 17) {
                 backgroundColor = "var(--border-color)";
             } else if (hour >= 17 && hour < 21) {
                 backgroundColor = "var(--primary-color-light)";
             } else {
                 backgroundColor = "var(--primary-color)";
             }

             circleContainer.style.backgroundColor = backgroundColor;
         }
     </script>
</body>
</html>