@{
    Layout = null;
    ViewData["Title"] = "404";
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AppDownloadListWeb</title>

    <!-- Styles -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto">
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
    <link rel="stylesheet" href="~/Styles/Common/styleCommon.css" />
    <link rel="stylesheet" href="~/Styles/Error/styleNotFound.css" />

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <!-- Javascript -->
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
</head>
<body>
    <!-- 主內容 -->
    <main class="container" role="main">
        <div class="hero-block">
            <!-- 左側面板 -->
            <div class="hero-block__left-panel">
                <div id="stars-container"></div>
                <div id="small-stars-container"></div>
                <div id="cross-container"></div>
                <div id="small-cross-container"></div>

                <div class="hero-block__planet">
                    <img class="img-fluid" src="~/Image/Space/06.svg" alt="planet">
                </div>
                <div class="hero-block__astronaut">
                    <img class="img-fluid" src="~/Image/Space/05.svg" alt="astronaut">
                </div>
            </div>

            <!-- 右側面板 -->
            <div class="hero-block__right-panel col-md-6 align-self-center">
                <h1>404</h1>
                <h2>UH OH! You're lost.</h2>
                <p>
                    The page you are looking for does not exist.
                </p>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            generateStars(10);
            generateSmallStars(20);
            generateCrosses(5);
            generateSmallCrosses(10);

            // 添加窗口大小變化監聽器
            window.addEventListener('resize', handleResponsiveElements);
        });

        let positionsArray = [];
        const minDistance = 10;

        function handleResponsiveElements() {
            positionsArray = [];
            const width = window.innerWidth;
            const starsCount = width < 768 ? 5 : 10;
            const smallStarsCount = width < 768 ? 10 : 20;
            const crossesCount = width < 768 ? 2 : 5;
            const smallCrossesCount = width < 768 ? 5 : 10;

            // 清除並重新生成星星
            document.getElementById('stars-container').innerHTML = '';
            document.getElementById('small-stars-container').innerHTML = '';
            document.getElementById('cross-container').innerHTML = '';
            document.getElementById('small-cross-container').innerHTML = '';

            generateStars(starsCount);
            generateSmallStars(smallStarsCount);
            generateCrosses(crossesCount);
            generateSmallCrosses(smallCrossesCount);
        }

        function generateStars(count) {
            const starsContainer = document.getElementById('stars-container');

            for (let i = 0; i < count; i++) {
                let top, left;
                let validPosition = false;
                let attempts = 0;
                const size = 20;

                while (!validPosition && attempts < 50) {
                    top = Math.random() * 90 + 5;     // 5-95%
                    left = Math.random() * 90 + 5;    // 5-95%

                    validPosition = true;

                    for (let j = 0; j < positionsArray.length; j++) {
                        const distance = Math.sqrt(
                            Math.pow(top - positionsArray[j].top, 2) +
                            Math.pow(left - positionsArray[j].left, 2)
                        );

                        if (distance < minDistance) {
                            validPosition = false;
                            break;
                        }
                    }

                    attempts++;
                }

                if (validPosition) {
                    positionsArray.push({ top, left });

                    const star = document.createElement('div');
                    star.className = 'hero-block__star';

                    const delay = Math.random() * 3;

                    star.style.top = top + '%';
                    star.style.left = left + '%';
                    star.style.width = size + 'px';
                    star.style.height = size + 'px';
                    star.style.animationDelay = delay + 's';

                    starsContainer.appendChild(star);
                }
            }
        }

        function generateSmallStars(count) {
            const starsContainer = document.getElementById('small-stars-container');

            for (let i = 0; i < count; i++) {

                let top, left;
                let validPosition = false;
                let attempts = 0;
                const size = 5;

                while (!validPosition && attempts < 50) {
                    top = Math.random() * 90 + 5;     // 5-95%
                    left = Math.random() * 90 + 5;    // 5-95%

                    validPosition = true;

                    for (let j = 0; j < positionsArray.length; j++) {
                        const distance = Math.sqrt(
                            Math.pow(top - positionsArray[j].top, 2) +
                            Math.pow(left - positionsArray[j].left, 2)
                        );

                        if (distance < minDistance) {
                            validPosition = false;
                            break;
                        }
                    }

                    attempts++;
                }

                if (validPosition) {
                    positionsArray.push({ top, left });

                    const star = document.createElement('div');
                    star.className = 'hero-block__smallStar';

                    const delay = Math.random() * 3;

                    star.style.top = top + '%';
                    star.style.left = left + '%';
                    star.style.width = size + 'px';
                    star.style.height = size + 'px';
                    star.style.animationDelay = delay + 's';

                    starsContainer.appendChild(star);
                }
            }
        }

        function generateCrosses(count) {
            const crossesContainer = document.getElementById('cross-container');

            for (let i = 0; i < count; i++) {
                let top, left;
                let validPosition = false;
                let attempts = 0;
                const size = Math.random() * 40 + 20;   // 20-60px

                while (!validPosition && attempts < 50) {
                    top = Math.random() * 90 + 5;     // 5-95%
                    left = Math.random() * 90 + 5;    // 5-95%

                    validPosition = true;

                    for (let j = 0; j < positionsArray.length; j++) {
                        const distance = Math.sqrt(
                            Math.pow(top - positionsArray[j].top, 2) +
                            Math.pow(left - positionsArray[j].left, 2)
                        );

                        if (distance < minDistance) {
                            validPosition = false;
                            break;
                        }
                    }

                    attempts++;
                }

                if (validPosition) {
                    positionsArray.push({ top, left });

                    const cross = document.createElement('div');
                    cross.className = 'hero-block__cross';

                    const delay = Math.random() * 3;
                    const position = 'absolute';
                    const backgroundColor = 'var(--primary-color-light)';
                    const borderRadius = '4px';

                    // 設定 ::before（橫線）
                    const before = document.createElement('div');
                    before.style.position = position;
                    before.style.width = '100%';
                    before.style.height = Math.max(size * 0.13, 4) + 'px';
                    before.style.top = '50%';
                    before.style.left = '0';
                    before.style.transform = 'translateY(-50%)';
                    before.style.backgroundColor = backgroundColor;
                    before.style.borderRadius = borderRadius;

                    cross.appendChild(before);

                    // 設定 ::after（直線）
                    const after = document.createElement('div');
                    after.style.position = position;
                    after.style.width = Math.max(size * 0.13, 4) + 'px';
                    after.style.height = '100%';
                    after.style.left = '50%';
                    after.style.top = '0';
                    after.style.transform = 'translateX(-50%)';
                    after.style.backgroundColor = backgroundColor;
                    after.style.borderRadius = borderRadius;

                    cross.appendChild(after);

                    cross.style.top = top + '%';
                    cross.style.left = left + '%';
                    cross.style.width = size + 'px';
                    cross.style.height = size + 'px';
                    cross.style.animationDelay = delay + 's';

                    crossesContainer.appendChild(cross);
                }
            }
        }

        function generateSmallCrosses(count) {
            const crossesContainer = document.getElementById('small-cross-container');

            for (let i = 0; i < count; i++) {
                let top, left;
                let validPosition = false;
                let attempts = 0;
                const size = 20;

                while (!validPosition && attempts < 50) {
                    top = Math.random() * 90 + 5;     // 5-95%
                    left = Math.random() * 90 + 5;    // 5-95%

                    validPosition = true;

                    for (let j = 0; j < positionsArray.length; j++) {
                        const distance = Math.sqrt(
                            Math.pow(top - positionsArray[j].top, 2) +
                            Math.pow(left - positionsArray[j].left, 2)
                        );

                        if (distance < minDistance) {
                            validPosition = false;
                            break;
                        }
                    }

                    attempts++;
                }

                if (validPosition) {
                    positionsArray.push({ top, left });

                    const cross = document.createElement('div');
                    cross.className = 'hero-block__smallCross';

                    const delay = Math.random() * 3;
                    const position = 'absolute';
                    const backgroundColor = 'var(--secondary-color)';
                    const borderRadius = '4px';

                    // 設定 ::before（橫線）
                    const before = document.createElement('div');
                    before.style.position = position;
                    before.style.width = '100%';
                    before.style.height = Math.max(size * 0.13, 4) + 'px';
                    before.style.top = '50%';
                    before.style.left = '0';
                    before.style.transform = 'translateY(-50%)';
                    before.style.backgroundColor = backgroundColor;
                    before.style.borderRadius = borderRadius;

                    cross.appendChild(before);

                    // 設定 ::after（直線）
                    const after = document.createElement('div');
                    after.style.position = position;
                    after.style.width = Math.max(size * 0.13, 4) + 'px';
                    after.style.height = '100%';
                    after.style.left = '50%';
                    after.style.top = '0';
                    after.style.transform = 'translateX(-50%)';
                    after.style.backgroundColor = backgroundColor;
                    after.style.borderRadius = borderRadius;

                    cross.appendChild(after);

                    cross.style.top = top + '%';
                    cross.style.left = left + '%';
                    cross.style.width = size + 'px';
                    cross.style.height = size + 'px';
                    cross.style.animationDelay = delay + 's';

                    crossesContainer.appendChild(cross);
                }
            }
        }
    </script>
    
</body>
</html>