<script src="~/Scripts/Common/owl.carousel.js"></script>
<script src="~/Scripts/Common/owl.carousel2.thumbs.js"></script>

<script>
    $(document).ready(function () {
        $(".banner-carousel").owlCarousel({
            loop: true,
            margin: 10,
            nav: false, // 啟用導航按鈕
            navText: ['<i class="bi bi-chevron-left"></i>', '<i class="bi bi-chevron-right"></i>'], // 添加Bootstrap圖標
            dots: true, // 啟用指示點
            autoplay: false, // 自動播放
            autoplayTimeout: 5000, // 5秒自動切換
            responsive: {
                0: {
                    items: 1
                },
                600: {
                    items: 2
                },
                1000: {
                    items: 3
                }
            }
        });

        $(".list-carousel").owlCarousel({
            loop: true,
            margin: 10,
            nav: false,
            navText: ['<i class="bi bi-chevron-left"></i>', '<i class="bi bi-chevron-right"></i>'],
            dots: false,
            responsive: {
                0: {
                    items: 1
                },
                600: {
                    items: 2
                },
                1000: {
                    items: 3
                }
            }
        });

        // 標籤頁切換功能
        $(".tab").click(function () {
            $(".tab").removeClass("active");
            $(this).addClass("active");
            // 這裡可以添加標籤頁切換後的業務邏輯
        });

    });
</script>
