@{
    ViewData["Title"] = "類型首頁";
}

<link rel="stylesheet" href="~/Styles/AppList/styleIndex.css" />
<link rel="stylesheet" href="~/Styles/Common/styleOwlCarousel.css" />

<div class="hero-section">
    <div class="section">
        <div class="section-inner">
            <div class="section-item" style="background-image: url('/Image/section.png');">
            </div>
        </div>
    </div>
</div>

<div class="hero-carousel">
    <div class="row">
        <div class="col-xl-8 mx-auto text-center mb-5">
            <h3>遊戲</h3>
        </div>

        <div class="owl-carousel owl-theme style-carousel banner-carousel">
            <div class="style-carousel-item">
                <div class="product">
                    <div class="product-image">
                        <a href="@Url.Action("Index", "Home")">
                            <img class="img-fluid" src="~/Image/Carousel/slide11.png" alt="product">
                        </a>
                    </div>
                    <div class="py-2 app-info">
                        <div class="app-icon">
                            <img src="~/Image/Carousel/slide21.png" alt="icon">
                        </div>
                        <div class="app-details">
                            <p class="text-muted text-sm mb-1">Trip</p>
                            <h3 class="h6 text-uppercase mb-1"><a class="text-dark" href="detail.html">旅遊</a></h3>
                            <span class="text-muted">
                                4.1
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-star-fill" viewBox="0 0 16 16">
                                    <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z" />
                                </svg>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="style-carousel-item">
                <div class="product">
                    <div class="product-image">
                        <a href="@Url.Action("Index", "Home")">
                            <img class="img-fluid" src="~/Image/Carousel/slide12.png" alt="product">
                        </a>
                    </div>
                    <div class="py-2 app-info">
                        <div class="app-icon">
                            <img src="~/Image/Carousel/slide02.png" alt="icon">
                        </div>
                        <div class="app-details">
                            <p class="text-muted text-sm mb-1">Tool</p>
                            <h3 class="h6 text-uppercase mb-1"><a class="text-dark" href="detail.html">生活氣象</a></h3>
                            <span class="text-muted">
                                4.1
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-star-fill" viewBox="0 0 16 16">
                                    <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z" />
                                </svg>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="style-carousel-item">
                <div class="product">
                    <div class="product-image">
                        <a href="@Url.Action("Index", "Home")">
                            <img class="img-fluid" src="~/Image/Carousel/slide13.png" alt="product">
                        </a>
                    </div>
                    <div class="py-2 app-info">
                        <div class="app-icon">
                            <img src="~/Image/Carousel/slide05.png" alt="icon">
                        </div>
                        <div class="app-details">
                            <p class="text-muted text-sm mb-1">Game</p>
                            <h3 class="h6 text-uppercase mb-1"><a class="text-dark" href="detail.html">積木益智</a></h3>
                            <span class="text-muted">
                                4.4
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-star-fill" viewBox="0 0 16 16">
                                    <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z" />
                                </svg>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="hero-carousel">
    <div class="row">
        <div class="col-xl-8 mx-auto text-center mb-5">
            <h3>熱門排行榜</h3>
        </div>

    </div>
</div>

<script src="~/Scripts/Common/owl.carousel.js"></script>
<script src="~/Scripts/Common/owl.carousel2.thumbs.js"></script>

<script>
    $(document).ready(function () {
        $(".product-carousel").owlCarousel({
            loop: true,
            margin: 10,
            nav: false,
            dots: false,
            responsive: {
                0: {
                    items: 1
                },
                600: {
                    items: 4
                },
                1000: {
                    items: 8
                }
            }
        });

        $(".banner-carousel").owlCarousel({
            loop: true,
            margin: 10,
            nav: false,
            dots: false,
            responsive: {
                0: {
                    items: 1
                },
                600: {
                    items: 2
                },
                1000: {
                    items: 3
                }
            }
        });
    });
</script>
